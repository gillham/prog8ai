# Editor settings for this project: https://editorconfig.org
root = true

# Defaults: UTF-8, Unix line endings and 4-space indents.  This also
# covers Prog8 (.p8) and 64tass assembler (.asm) sources.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# make needs recipe lines indented with tabs
[Makefile]
indent_style = tab

# Trailing spaces can be significant in Markdown (line breaks)
[*.{md,rst}]
trim_trailing_whitespace = false

[.gitignore]
indent_size = 2
