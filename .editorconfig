# EditorConfig for Prog8 *user* projects
# Ensures consistent formatting across editors and team members
# See https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Prog8 source files (.p8)
[*.p8]
indent_style = space
indent_size = 4

# Assembly files (.asm) - 64tass syntax
[*.asm]
indent_style = space
indent_size = 4

# Makefiles require real tabs
[Makefile]
indent_style = tab
indent_size = 4

# Documentation files
[*.md]
trim_trailing_whitespace = false

[*.rst]
trim_trailing_whitespace = false

# Git ignore files
[.gitignore]
indent_style = space
indent_size = 2
